<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <!-- == PACKAGE SPECIFIC SECTION == -->
    <id>bun</id>
    <version>1.4.3</version>
    <packageSourceUrl>https://github.com/readycool/choco.bun</packageSourceUrl>
    <owners>readycool</owners>

    <!-- == SOFTWARE SPECIFIC SECTION == -->
    <title>Bun</title>
    <authors>Oven</authors>
    <projectUrl>https://bun.com/</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/readycool/choco.bun/bun.png</iconUrl>
    <copyright>Copyright (c) Oven</copyright>
    <licenseUrl>https://github.com/oven-sh/bun/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/oven-sh/bun</projectSourceUrl>
    <docsUrl>https://bun.com/docs</docsUrl>
    <tags>bun javascript typescript runtime</tags>
    <summary>A fast all-in-one JavaScript runtime</summary>
    <description>Bun is a fast JavaScript runtime &amp; toolkit. All in one. Runtime, package manager, test runner and bundler in a single binary.</description>
    <releaseNotes>https://bun.com/blog/bun-v1.4.3</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
